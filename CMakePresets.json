{
  "version": 3,
  "configurePresets": [
    {
      "name": "vs2022-x64",
      "displayName": "Visual Studio 2022 x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/vs2022-x64"
    },
    {
      "name": "vs2022-x86",
      "displayName": "Visual Studio 2022 Win32",
      "inherits": "vs2022-x64",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/out/build/vs2022-x86"
    },
    {
      "name": "portable",
      "displayName": "Native CMake build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/portable",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release-x64",
      "configurePreset": "vs2022-x64",
      "configuration": "Release"
    },
    {
      "name": "debug-x64",
      "configurePreset": "vs2022-x64",
      "configuration": "Debug"
    },
    {
      "name": "release-x86",
      "configurePreset": "vs2022-x86",
      "configuration": "Release"
    },
    {
      "name": "debug-x86",
      "configurePreset": "vs2022-x86",
      "configuration": "Debug"
    },
    {
      "name": "portable",
      "configurePreset": "portable"
    }
  ],
  "testPresets": [
    {
      "name": "release-x64",
      "configurePreset": "vs2022-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-x64",
      "configurePreset": "vs2022-x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "portable",
      "configurePreset": "portable",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
